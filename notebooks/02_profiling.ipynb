    "import pandas as pd\n",
    "from ydata_profiling import ProfileReport\n",
    "\n",
    "df = pd.read_csv(\"../data/raw/store-data-6aa6d7a3f171f140353680.csv\")\n",
    "\n",
    "profile = ProfileReport(df, title=\"DataStore360 - Rapport de Profiling\", explorative=True)\n",
    "profile.to_file(\"../reports/rapport_profiling.html\")"
   ]
  }
